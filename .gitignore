# ─────────────────────────────────────────────
#  HotChords .gitignore
# ─────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
venv/
env/
.env
.venv

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Audio files (do not commit test songs or personal files)
*.mp3
*.wav
*.flac
*.m4a
*.ogg
*.aac
*.opus

# MIDI outputs (generated by the app at runtime)
*.mid
*.midi

# Demucs stem outputs (written to system temp dir at runtime)
# The app writes these to /tmp/hotchords_stems/ — no action needed here.
# If you ever configure a local stems dir, exclude it:
stems/
hotchords_stems/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Logs
*.log

# Temp / generated
tmp/
temp/
.cache/
.pytest_cache/
*.zip

# Node modules
node_modules/

# Cursor / agent IDE directories
.agents/


# PyTorch model cache (Demucs downloads these automatically)
# Located in ~/.cache/torch — not in project dir, no action needed.
