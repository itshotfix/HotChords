# HotChords Environment Configuration Template
# Copy this file to .env for custom local settings.

# Server Configuration
HOST=127.0.0.1
PORT=5501
RELOAD=false
LOG_LEVEL=info

# Audio Processing & Temporary Storage
# Optional: Directory for temporary stem outputs (defaults to system temporary directory)
# HOTCHORDS_TEMP_DIR=/tmp/hotchords_stems

# Device Selection (Options: cpu, cuda, mps - defaults to automatic hardware detection)
# TORCH_DEVICE=cpu
